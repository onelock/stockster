FROM python:3.11-slim

WORKDIR /app

# Install system dependencies (only curl for health checks)
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY dashboard/requirements_dsh.txt trading_engine/requirements_trdeng.txt ./
RUN pip install --no-cache-dir -r requirements_dsh.txt
RUN pip install --no-cache-dir -r requirements_trdeng.txt

# Copy application code
COPY dashboard/ ./dashboard/
COPY analysis/ ./analysis/
COPY app/ ./app/

# Create data directory
RUN mkdir -p /data

# Set environment variables
ENV ENVIRONMENT=production
ENV PYTHONUNBUFFERED=1

# Expose port
EXPOSE 8501

# Run dashboard
CMD ["streamlit", "run", "dashboard/main.py", "--server.port=8501", "--server.address=0.0.0.0"]
